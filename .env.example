# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Spring Boot loads .env automatically from the project root (see application.properties).
# Real environment variables (e.g. on Railway) override values in .env.

# --- Database (PostgreSQL) ---
# JDBC URL. Defaults to jdbc:postgresql://localhost:5432/myproject if unset.
DB_URL=jdbc:postgresql://localhost:5432/myproject
# Defaults to postgres if unset.
DB_USERNAME=postgres
# Required.
DB_PASSWORD=change-me

# --- JWT ---
# Required. At least 32 characters (HS256 key). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Optional. Access token lifetime in milliseconds (default 3600000 = 1 hour). The frontend renews
# it automatically with the refresh token, so users are not logged out when it expires.
# JWT_EXPIRATION=3600000
# Optional. Refresh token lifetime in days (default 7). Each renewal starts a new period, so only
# users who are inactive for longer than this have to log in again.
# REFRESH_TOKEN_TTL_DAYS=7

# --- Server ---
# Optional. Defaults to 8080.
# PORT=8080

# --- Email (signup verification) ---
# Optional locally: without MAIL_HOST the code is printed in the backend log.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-character-app-password

# --- CoinGecko ---
# Optional. A free Demo API key (https://www.coingecko.com/en/api/pricing) raises the rate limit.
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx
